---
// src/pages/join.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="JOIN // PINK CODING CLUB" 
  description="Join the exclusive Pink Coding Club. We'll talk fashion, the latest technology frameworks, and all things fun!."
  isIndex={false} 
  version="Join // V.01"
>

  <div class="locked-container">
    <div class="content-wrapper">
      <h1 class="title">The Exclusive Club</h1>
      <p class="subtitle">coming soon</p>
      
      <!-- The form doesn't submit anywhere yet, it just prevents default reload -->
      <form class="password-form" onsubmit="event.preventDefault();">
        <input 
          type="password" 
          placeholder="ENTER PASSWORD" 
          class="password-input" 
          autocomplete="off"
        />
        <button type="submit" class="submit-btn" aria-label="Submit Password">
          &rarr;
        </button>
      </form>
    </div>
  </div>

</BaseLayout>

<style>

  
  .locked-container {
    display: flex;
    align-items: center;
    justify-content: center;
  
    min-height: 75vh; 
    width: 100%;
    padding: 2rem;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }


  .title {
     font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2rem, 5vw, 4rem); 
    font-weight: 300; 
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0;

   
  }


  .subtitle {
    font-size: 0.85rem;
    letter-spacing: 0.4em;
    text-transform: lowercase;
    opacity: 0.35;
    margin-top: 1rem;
    font-weight: 400;
  }


  .password-form {
    display: flex;
    align-items: center;
    margin-top: 4rem;
    border-bottom: 1px solid rgba(150, 150, 150, 0.4);
    padding-bottom: 0.5rem;
    transition: border-color 0.4s ease;
  }


  .password-form:focus-within {
    border-bottom-color: #ff69b4; 
  }

  .password-input {
    background: transparent;
    border: none;
    outline: none;
    color: currentColor;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-align: center;
    width: 250px;
    padding: 0.5rem;
    font-weight: 300;
  }

  .password-input::placeholder {
    color: currentColor;
    opacity: 0.3;
  }


  .submit-btn {
    background: transparent;
    border: none;
    color: currentColor;
    font-size: 1.2rem;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.4s ease, color 0.4s ease, transform 0.4s ease;
    padding: 0 0.5rem;
  }

  .submit-btn:hover {
    opacity: 1;
    color: #ff69b4;
    transform: translateX(4px); 
  }
</style>
