---
// src/pages/join.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="JOIN // PINK CODING CLUB" isIndex={false} version="Join // V.01">

  <span slot="hero-title">Become an Icon</span>

  <section class="police-tape-wrapper">
    <div class="tape tape-1">
      <div class="tape-track">
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
      </div>
    </div>

    <div class="tape tape-2">
      <div class="tape-track reverse">
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
      </div>
    </div>

    <div class="tape tape-3">
      <div class="tape-track">
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
      </div>
    </div>

    <div class="tape tape-4">
      <div class="tape-track reverse">
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
        <span>EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// EXCLUSIVE CIRCLE COMING SOON /// </span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .police-tape-wrapper {
    position: relative;
    width: 100%;
    min-height: 65vh;
    background: #000000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 80px 0;
    gap: 35px;
    border-bottom: 1px solid var(--border-gray, #222);
  }

  .tape {
    width: 130vw;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(1.2rem, 3.5vw, 2.5rem);
    font-weight: 900;
    text-transform: uppercase;
    padding: 12px 0;
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.9);
  }

  .tape-track {
    display: flex;
    width: max-content;
    animation: marquee 16s linear infinite;
  }

  .tape-track.reverse {
    animation: marquee-reverse 18s linear infinite;
  }

  .tape-track span {
    padding-right: 20px;
    letter-spacing: 2px;
  }

  /* Color & Rotation Variations */

  .tape-1 {
    background: #FF007A; 
    color: #000000;
    transform: rotate(-3deg);
  }

  .tape-2 {
    background: #FFE600; 
    color: #000000;
    transform: rotate(2.5deg);
  }

  .tape-3 {
    background: #FF007A;
    color: #000000;
    transform: rotate(-2deg);
  }

  .tape-4 {
    background: #FFE600;
    color: #000000;
    transform: rotate(4deg);
  }

  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }

  @media (max-width: 768px) {
    .police-tape-wrapper {
      min-height: 55vh;
      padding: 60px 0;
      gap: 25px;
    }

    .tape {
      width: 160vw;
      padding: 10px 0;
    }
  }
</style>
