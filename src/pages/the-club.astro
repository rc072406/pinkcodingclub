---
// src/pages/join.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="JOIN // PINK CODING CLUB" 
 description="Join the exclusive Pink Coding Club. We'll talk fashion, the latest technology frameworks, and all things fun!."
isIndex={false} 
version="Join // V.01">

  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
          <span>EXCLUSIVE CIRCLE COMING SOON // </span>
        </div>
      </div>
    </div>
  </section>

<section class="chaos-footer">
    <div class="stack-container">
        <h2 class="stack-text outline slide-left">EXCLUSIVE CIRCLE COMING SOON</h2>
        <h2 class="stack-text solid">// EXCLUSIVE CIRCLE COMING</h2>
        <h2 class="stack-text outline-faded slide-right">SOON // EXCLUSIVE CIRCLE //</h2>
        <h2 class="stack-text solid-overlap">COMING SOON // EXCLUSIVE //</h2>
        <h2 class="stack-text outline-bold">CIRCLE COMING SOON // //</h2>
    </div>
</section>
  

</BaseLayout>

<style>

/* --- HERO SECTION STYLES --- */
.hero-section {
    padding: 100px 0; 
    display: flex;
    flex-direction: column;
    gap: 0; 
    overflow: hidden;
    cursor: crosshair;
}

.hero-row {
    position: relative;
    width: 100vw;
    z-index: 10;
}

.marquee {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);

}

.track {
    display: flex;
    animation: scroll-left 20s linear infinite;
    width: max-content; 
   -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-perspective: 1000;
    perspective: 1000;
    will-change: transform;
}

.hero-row span {
    font-family: var(--inter); 
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 10rem);
    line-height: 0.8;
    color: #fff;
    padding-right: 20px;
    transition: all 0.4s ease;
    flex-shrink: 0;
    -webkit-transform: translateZ(0);
}


.ghost-row span {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.4);
    margin-top: -20px; 
}

/* --- ANIMATIONS --- */
@keyframes scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

.reverse .track {
    animation-direction: reverse;
}

/* --- HOVER INTERACTION --- */

.hero-section:hover .hero-row span {
    color: transparent;
    -webkit-text-stroke: 1px var(--accent);
}

.hero-section:hover .ghost-row span {
    color: #fff;
    -webkit-text-stroke: 0px transparent;
    text-shadow: 0 0 20px rgba(255,255,255,0.2);
}


.hero-section:hover .track {
    animation-duration: 5s; /* Speeds up on hover */
}
.chaos-footer {
    background: transparent !important; 
    padding: 100px 0;
    overflow: hidden;
    width: 100%;
    z-index: 2000 !important;
}

.stack-container {
    display: flex;
    flex-direction: column;
    align-items: center; /* Centers the stack generally */
}

.stack-text {
    font-family: var(--inter);
    font-weight: 900;
    font-size: clamp(3rem, 12vw, 10rem);
    line-height: 0.75; 
    margin-top: -0.3em; 
    white-space: nowrap;
    text-transform: uppercase;
    transition: all 0.3s ease;
}


.stack-text.solid {
    color: #fff;
    z-index: 10;
}

.stack-text.solid-overlap {
    color: #fff;
    z-index: 8;
    margin-left: -5%; 
}

.stack-text.outline {
    color: transparent;
    -webkit-text-stroke: 1.5px #fff;
    z-index: 5;
}

.stack-text.outline-faded {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.3);
    z-index: 2;
}

.stack-text.outline-bold {
    color: transparent;
    -webkit-text-stroke: 2px var(--pink-hot);
    z-index: 1;
}


.slide-left { transform: translateX(-10%); }
.slide-right { transform: translateX(10%); }


.stack-container:hover .stack-text {
    margin-top: -0.1em; 
    -webkit-text-stroke: 1px #fff;
}
<style>
