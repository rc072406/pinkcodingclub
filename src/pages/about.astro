---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Pink Coding Club" isIndex={false} showHero={false}>
  <div class="page-container">
    
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <nav class="side-nav">
        <a href="#about" class="nav-link active" data-target="about">ABOUT</a>
        <a href="#business" class="nav-link" data-target="business">BUSINESS</a>
        <a href="#contact" class="nav-link" data-target="contact">CONTACT</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="content-wrapper">
      
      <!-- ABOUT SECTION -->
      <section id="about" class="content-section">
        <h1 class="pink-title">ABOUT</h1>
        <div class="text-block">
          <p>As a young girl, Rachel always hated coding and thought it was the most milquetoast of things. Finding chatbots that asked for pizza preferences mundane, she gave up on coding and wanted nothing to do with it. Only when she reached adulthood, she realized coding was another creative medium like fashion or poetry, and that schools separated the arts and STEM when they should been taught to be connected. </p>
          <br>
          <p>But after hearing many personal anecdotes where women stripped themselves of their femineity to feel accepted by the tech community, Rachel knew there was something awry with the current culture. So then, disillusioned by the education system and tech industry, Rachel created the Pink Coding Club to counter the hyper-masculine and uninviting world of tech. Pink Coding Club does not only educate through art and fashion, but empowers the "girly girl" and helps her remember that she does have a place in technology whether others like it or not. </p>
          <br>
          <p>The hyper-feminine perspective in technology is valuable not only for its impeccable design, but for its insights in representation, accessibility, and trauma-minded design. Every single one of her designs is not only made with love, but pure passion as well. This perspective changes the game and goes beyond simply creating trends. </p>
       <br>
<p>Transcending far beyond just education, P.C.C. marks itself as rebellion in the industry, carving a path for the next generation of girls. Unapologetically herself, a P.C.C. member is not only an innovator, but defines the future of technology. She can design. She can create. She can do anything. She leads the culture.</p>


</div>

 <h2 class="sub-title">Our Principles</h2>
        <ul class="principles-list">
          <li><strong>Originality</strong> — Do not plagiarize another's wor</li>
          <li><strong>Credit</strong> — We clearly attribute every contributor: photographers, stylists and more.</li>
          <li><strong>Transparency</strong> — Sponsored or advertising content is clearly distinguished from editorial.</li>
          <li><strong>Accuracy</strong> — For celebrity and news coverage we verify sources and correct errors promptly.</li>
          <li><strong>Image rights</strong> — We respect image rights and their scope of use.</li>
        </ul>

        <h3 class="faq-title">FREQUENTLY ASKED QUESTIONS</h3>
        <div class="faq-list">
          <div class="faq-item"><span>What is Pink Coding Club?</span> <span class="plus">+</span></div>
          <div class="faq-item"><span>Is learning at Pink Coding Club free?</span> <span class="plus">+</span></div>
          <div class="faq-item"><span>Do I need to attend weekly classes?</span> <span class="plus">+</span></div>
         
        </div>
      </section>

      <!-- BUSINESS SECTION -->
      <section id="business" class="content-section">
        <h1 class="pink-title">BUSINESS</h1>
        
       
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="content-section">
        <h1 class="pink-title">CONTACT</h1>
        
      
          
          <div class="contact-col">
            <h4>EMAIL</h4>
            <p><a href="" class="email-link">Soon to come</a></p>
            
           
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<script>

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll(".content-section");
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.3 
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.remove("active");
            if (link.getAttribute("data-target") === entry.target.id) {
              link.classList.add("active");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => {
      observer.observe(section);
    });
  });
</script>

<style>



  .page-container {
    display: flex;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
    font-family: 'Inter', sans-serif;
  }

  /* Sidebar Styling */
  .sidebar {
    width: 80px;
    flex-shrink: 0;
  }

  .side-nav {
    position: sticky;
    top: 100px; 
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .nav-link {
    writing-mode: vertical-rl;
    text-orientation: upright;
    color: #555555;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    transition: color 0.3s ease;
    text-transform: uppercase;
  }

  .nav-link:hover, .nav-link.active {
    color: #ffffff;
  }

  /* Main Content Wrapper */
  .content-wrapper {
    flex-grow: 1;
    max-width: 900px;
    padding-left: 2rem;
  }

  .content-section {
    padding-bottom: 8rem;
    min-height: 80vh;
  }


  .pink-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: 5rem;
    color: #facee2;
    text-transform: uppercase;
    margin-bottom: 2rem;
    letter-spacing: -2px;
  }

  .text-block p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #d1d1d1;
    text-transform: none; 
  }


  .sub-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    margin-top: 1.5rem;
    font-family: 'Archivo Black', sans-serif;
  }

  .principles-list {
    list-style: none;
    padding: 0;
    margin-bottom: 4rem;
  }

  .principles-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #222;
    color: #d1d1d1;
    font-size: 1rem;
    text-transform: none;
  }

  .principles-list li strong {
    color: #ffffff;
  }

  .faq-title {
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .faq-list {
    border-top: 1px solid #222;
  }

  .faq-item {
    display: flex;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-bottom: 1px solid #222;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s;
  }
  
  .faq-item:hover {
    color: #facee2;
  }

  /* Contact Section Styling */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .contact-col h4 {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: #888;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .contact-col p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #e0e0e0;
  }

  .email-link {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mt-8 {
    margin-top: 3rem;
  }

  .media-kit-buttons {
    display: flex;
    gap: 1rem;
  }

  .outline-btn {
    background: transparent;
    border: 1px solid #444;
    color: #fff;
    padding: 0.5rem 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .outline-btn:hover {
    border-color: #facee2;
    color: #facee2;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .page-container {
      padding: 2rem 1rem;
    }

    .sidebar {
      width: 40px;
    }

    .side-nav {
      top: 80px;
      gap: 2rem;
    }

    .nav-link {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
    }

    .content-wrapper {
      padding-left: 1rem;
    }

    .pink-title {
      font-size: 3rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
