---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import IconFeature from '../components/IconFeature.astro';
import InterviewGallery from '../components/InterviewGallery.astro';
import FounderSection from '../components/FounderSection.astro';
const base = import.meta.env.BASE_URL;

---

<BaseLayout 
  title="P.C.C. // PINK CODING CLUB" 
  isIndex={true} 
  showHero={true}
  version="V.01 // RECODING FEMININITY"
>
  
  <link rel="stylesheet" href="/styles/index.css" slot="head" />

<IconFeature />
<InterviewGallery />
<FounderSection />
<!-- TICKER / MARQUEE SECTION -->
<section class="ticker-wrapper">
  <div class="ticker-track">
    
    <!-- First set of links -->
    <div class="ticker-content">
      <a href="#index" class="c-white">INDEX</a>
      <a href="#portal" class="c-pink-soft">PORTAL</a>
      <a href="#about" class="c-pink-hot">ABOUT</a>
      <a href="#business" class="c-white">BUSINESS</a>
      <a href="#contact" class="c-pink-soft">CONTACT</a>
      <a href="#manifesto" class="c-pink-hot">MANIFESTO</a>
      <a href="#curriculum" class="c-pink-soft">CURRICULUM</a>
      <a href="#the-club" class="c-white">THE CLUB</a>
    </div>


    <div class="ticker-content" aria-hidden="true">
      <a href="#index" class="c-white">INDEX</a>
      <a href="#portal" class="c-pink-soft">PORTAL</a>
      <a href="#about" class="c-pink-hot">ABOUT</a>
      <a href="#business" class="c-white">BUSINESS</a>
      <a href="#contact" class="c-pink-soft">CONTACT</a>
      <a href="#manifesto" class="c-pink-hot">MANIFESTO</a>
      <a href="#curriculum" class="c-pink-soft">CURRICULUM</a>
      <a href="#the-club" class="c-white">THE CLUB</a>
    </div>

  </div>
</section>

</BaseLayout>
<style>
/* --- TICKER / MARQUEE SECTION --- */
.ticker-wrapper {
  width: 100%;
  padding: 60px 0;
  background: var(--bg-black);
  overflow: hidden;
  border-top: 1px solid var(--border-gray);
  border-bottom: 1px solid var(--border-gray);
  

  -webkit-mask-image: linear-gradient(
    to right, 
    transparent 0%, 
    black 15%, 
    black 85%, 
    transparent 100%
  );
  mask-image: linear-gradient(
    to right, 
    transparent 0%, 
    black 15%, 
    black 85%, 
    transparent 100%
  );
}

.ticker-track {
  display: flex;
  width: max-content;
  user-select: none;
}

.ticker-content {
  display: flex;
  align-items: center;
  gap: 4rem; /* Space between words */
  padding-right: 4rem; /* Match gap for seamless loop */
  animation: scroll-left 25s linear infinite;
  will-change: transform;
}


.ticker-wrapper:hover .ticker-content {
  animation-play-state: paused;
}


.ticker-content a {
  font-family: 'Archivo Black', sans-serif;
  font-size: clamp(2rem, 5vw, 4rem);
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  letter-spacing: -1px;
  transition: opacity 0.3s ease, transform 0.3s ease;
}


.ticker-content a.c-white {
  color: #ffffff;
}

.ticker-content a.c-pink-soft {
  color: var(--pink-soft);
}

.ticker-content a.c-pink-hot {
  color: var(--pink-hot);
}


.ticker-content a:hover {
  opacity: 0.4;
}

/* Continuous Infinite Keyframe Loop */
@keyframes scroll-left {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-100%);
  }
}

/* Responsive speed check */
@media (max-width: 768px) {
  .ticker-content {
    gap: 2.5rem;
    padding-right: 2.5rem;
    animation-duration: 18s; 
  }
  .ticker-wrapper {
    padding: 35px 0;
  }
}
</style>
