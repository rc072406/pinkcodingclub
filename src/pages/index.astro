---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import IconFeature from '../components/IconFeature.astro';
import InterviewGallery from '../components/InterviewGallery.astro';
import FounderSection from '../components/FounderSection.astro';
const base = import.meta.env.BASE_URL;

---

<BaseLayout 
  title="P.C.C. // Free Coding Camp for Girls" 
  isIndex={true} 
  showHero={true}
  version="V.01 // RECODING FEMININITY"
>
  
  <link rel="stylesheet" href="/styles/index.css" slot="head" />

<IconFeature />
<InterviewGallery />
<FounderSection />
<!-- TICKER / MARQUEE SECTION -->
<section class="ticker-wrapper">
  <div class="ticker-track">
    
    <!-- First set of links -->
    <div class="ticker-content">
      <a href={base} class="c-white">INDEX</a>
      <a href="#portal" class="c-pink-soft">PORTAL</a>
      <a href="/about" class="c-pink-hot">ABOUT</a>
      <a href="/about/#business" class="c-white">BUSINESS</a>
      <a href="/about/#contact" class="c-pink-soft">CONTACT</a>
      <a href="/manifesto" class="c-pink-hot">MANIFESTO</a>
      <a href="/curriculum" class="c-pink-soft">CURRICULUM</a>
      <a href="/the-club" class="c-white">THE CLUB</a>
    </div>


       <div class="ticker-content">
      <a href={base} class="c-white">INDEX</a>
      <a href="#portal" class="c-pink-soft">PORTAL</a>
      <a href="/about" class="c-pink-hot">ABOUT</a>
      <a href="/about/#business" class="c-white">BUSINESS</a>
      <a href="/about/#contact" class="c-pink-soft">CONTACT</a>
      <a href="/manifesto" class="c-pink-hot">MANIFESTO</a>
      <a href="/curriculum" class="c-pink-soft">CURRICULUM</a>
      <a href="/the-club" class="c-white">THE CLUB</a>
    </div>

  </div>
</section>

</BaseLayout>
<style>

.ticker-wrapper {
  width: 100%;
  padding: 60px 0;
  background: var(--bg-black);
  overflow: hidden;
  border-bottom: 1px solid var(--border-gray);
  
  -webkit-mask-image: linear-gradient(
    to right, 
    transparent 0%, 
    black 15%, 
    black 85%, 
    transparent 100%
  );
  mask-image: linear-gradient(
    to right, 
    transparent 0%, 
    black 15%, 
    black 85%, 
    transparent 100%
  );


  -webkit-transform: translateZ(0);
  transform: translateZ(0);
}

.ticker-track {
  display: flex;
  width: max-content;
  user-select: none;
}

.ticker-content {
  display: flex;
  flex-shrink: 0; 
  align-items: center;
  animation: scroll-left 25s linear infinite;
  
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  transform: translate3d(0, 0, 0); 
  
  /* 1. Tell Safari to maintain 3D rendering for its children */
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
}

.ticker-content a {
  font-family: 'Archivo Black', sans-serif;
  font-size: clamp(2rem, 5vw, 4rem);
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  letter-spacing: -1px;
  transition: opacity 0.3s ease, transform 0.3s ease;
  
  margin-right: 4rem; 
  display: inline-block;
  -webkit-font-smoothing: antialiased; 
  -moz-osx-font-smoothing: grayscale;

  /* 2. Force each word into its own hardware layer */
  /* This prevents the single giant texture from exceeding iOS limits */
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

.ticker-content a.c-white { color: #ffffff; }
.ticker-content a.c-pink-soft { color: var(--pink-soft); }
.ticker-content a.c-pink-hot { color: var(--pink-hot); }

.ticker-content a:hover {
  opacity: 0.4;
}

@keyframes scroll-left {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-100%, 0, 0); }
}

@media (max-width: 768px) {
  .ticker-content {
    animation-duration: 18s; 
  }
  .ticker-content a {
    margin-right: 2.5rem; 
  }
  .ticker-wrapper {
    padding: 35px 0;
  }
}
</style>
