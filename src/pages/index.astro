---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import IconFeature from '../components/IconFeature.astro';
import InterviewGallery from '../components/InterviewGallery.astro';
import FounderSection from '../components/FounderSection.astro';
const base = import.meta.env.BASE_URL;

---

<BaseLayout 
  title="P.C.C. // PINK CODING CLUB" 
  isIndex={true} 
  showHero={true}
  version="V.01 // RECODING FEMININITY"
>
  
  <link rel="stylesheet" href="/styles/index.css" slot="head" />

<IconFeature />
<InterviewGallery />
<FounderSection />

<!-- Horizontal Scroll Container (The Rack) -->
  <div class="history-slider">
    
    <!-- Era 01 -->
    <article class="comp-card">
      <div class="clips"><div class="clip"></div><div class="clip"></div></div>
      <div class="card-top">
        <div class="era-portrait">
          <span class="era-num">01</span>
        </div>
        <div class="era-stats">
          <div class="stat-box title"><h3>PURPLE MOON & BRENDA LAUREL</h3></div>
          <div class="stat-box">Era : 1990s</div>
          <div class="stat-box status">Status : ROUGH START</div>
        </div>
      </div>
      <div class="card-grid">
        <div class="look-box">
          <div class="look-num">LOOK 1</div>
          <p>The first major push to get girls on computers. While groundbreaking, early efforts relied on narrow assumptions.</p>
          <div class="look-footer">COMPUTERS ARE A GIRL'S BEST FRIEND?</div>
        </div>
      </div>
    </article>

    <!-- Era 02 -->
    <article class="comp-card">
      <div class="clips"><div class="clip"></div><div class="clip"></div></div>
      <div class="card-top">
        <div class="era-portrait">
          <span class="era-num">02</span>
        </div>
        <div class="era-stats">
          <div class="stat-box title"><h3>PINK IT AND SHRINK IT</h3></div>
          <div class="stat-box">Era : LATE 90s - 2000s</div>
          <div class="stat-box status">Status : ROUGH START</div>
        </div>
      </div>
      <div class="card-grid">
        <div class="look-box">
          <div class="look-num">LOOK 2</div>
          <p>Tech hardware went pink, but software lacked substance. Powerbabe focused heavily on gossip and stereotypes over creation.</p>
          <div class="look-footer">DEMONIZED FEMININITY</div>
        </div>
      </div>
    </article>

    <!-- Era 03 -->
    <article class="comp-card">
      <div class="clips"><div class="clip"></div><div class="clip"></div></div>
      <div class="card-top">
        <div class="era-portrait">
          <span class="era-num">03</span>
        </div>
        <div class="era-stats">
          <div class="stat-box title"><h3>CREATIVE PLAY</h3></div>
          <div class="stat-box">Era : 2000s - 2010s</div>
          <div class="stat-box status good">Status : TURNING POINT</div>
        </div>
      </div>
      <div class="card-grid">
        <div class="look-box">
          <div class="look-num">LOOK 3</div>
          <p>Online portals shifted focus toward fashion as agency, customization, and world-building. Girls were navigating digital environments on their own terms.</p>
          <div class="look-footer">FASHION AS AGENCY</div>
        </div>
      </div>
    </article>

    <!-- Era 04 -->
    <article class="comp-card highlight">
      <div class="clips"><div class="clip"></div><div class="clip"></div></div>
      <div class="card-top">
        <div class="era-portrait">
          <span class="era-num">04</span>
        </div>
        <div class="era-stats">
          <div class="stat-box title"><h3>PINK CODING CLUB</h3></div>
          <div class="stat-box">Era : NOW</div>
          <div class="stat-box status good">Status : THE RECODE</div>
        </div>
      </div>
      <div class="card-grid">
        <div class="look-box">
          <div class="look-num">LOOK 4 // FINAL</div>
          <p>Taking the aesthetic joy of fashion, makeup, and design and reclaiming it as real engineering power. Code is the ultimate creative medium.</p>
          <div class="look-footer">SYSTEM OVERRIDE</div>
        </div>
      </div>
    </article>

  </div>

</BaseLayout>
<style>

.history-slider {
    display: flex;
    gap: 50px; 
    overflow-x: auto;
    padding: 20px 0 60px 0;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
}

.history-slider::-webkit-scrollbar { height: 4px; }
.history-slider::-webkit-scrollbar-track { background: var(--bg-black); }
.history-slider::-webkit-scrollbar-thumb { background: var(--pink-hot); }

/* The Backstage Comp Card */
.comp-card {
    flex: 0 0 420px;
    scroll-snap-align: center;
    background: #f4f4f4; /* Off-white paper look */
    position: relative;
    padding: 25px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    color: #111; /* Stark black text */
    /* Subtle shadow to separate from the black background */
    box-shadow: 10px 10px 0px rgba(228, 30, 129, 0.2); 
    transition: transform 0.3s ease;
}

.comp-card:hover {
    transform: translateY(-5px);
}

/* The Binder Clips */
.clips {
    position: absolute;
    top: -15px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 0 40px;
    pointer-events: none;
}

.clip {
    width: 25px;
    height: 35px;
    background: #222;
    border-radius: 2px;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
    position: relative;
}
.clip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -5px;
    right: -5px;
    height: 2px;
    background: #555; /* Metal wire illusion */
}

/* Card Header Structure (Headshot + Stats) */
.card-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 10px;
    margin-top: 10px;
}

.era-portrait {
    background: #ccc;
    border: 1px solid #111;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140px;
}

.era-num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 4rem;
    color: #fff;
    -webkit-text-stroke: 1px #111;
}

.era-stats {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.stat-box {
    border: 1px solid #111;
    padding: 8px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
}

.stat-box.title {
    flex-grow: 1;
    display: flex;
    align-items: center;
    background: #111;
}

.stat-box.title h3 {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.1rem;
    color: #f4f4f4; 
    margin: 0;
    line-height: 1;
}

/* The Grid (The "Looks") */
.card-grid {
    border: 1px solid #111;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.look-box {
    padding: 15px;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.look-num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.2rem;
    margin-bottom: 10px;
}

.look-box p {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    line-height: 1.5;
    flex-grow: 1;
}

.look-footer {
    font-family: 'Inter', sans-serif;
    font-style: italic;
    font-size: 0.7rem;
    border-top: 1px solid #111;
    padding-top: 8px;
    margin-top: 15px;
}

/* Special Highlight Card */
.comp-card.highlight {
    background: var(--pink-hot);
    box-shadow: 10px 10px 0px rgba(255, 255, 255, 0.1);
}

.comp-card.highlight .era-portrait { background: #111; }
.comp-card.highlight .era-num { color: var(--pink-hot); -webkit-text-stroke: 1px #111; }
.comp-card.highlight .stat-box { border-color: #111; color: #111; }
.comp-card.highlight .card-grid { border-color: #111; }
.comp-card.highlight .look-footer { border-color: #111; }

@media (max-width: 768px) {
    .comp-card { flex: 0 0 320px; }
    .card-top { grid-template-columns: 1fr; }
    .era-portrait { min-height: 100px; }
}
</style>
