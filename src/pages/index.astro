---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import IconFeature from '../components/IconFeature.astro';
import InterviewGallery from '../components/InterviewGallery.astro';
const base = import.meta.env.BASE_URL;

---

<BaseLayout 
  title="P.C.C. // PINK CODING CLUB" 
  isIndex={true} 
  showHero={true}
  version="V.01 // RECODING FEMININITY"
>
  
  <link rel="stylesheet" href="/styles/index.css" slot="head" />

<IconFeature />
<InterviewGallery />
<!-- FOUNDER SECTION: CASTING CARD -->
<section class="casting-section">
  <div class="casting-board">
    
    <!-- CSS Binder Clips -->
    <div class="clip clip-left">
      <div class="clip-metal"></div>
      <div class="clip-black"></div>
    </div>
    <div class="clip clip-right">
      <div class="clip-metal"></div>
      <div class="clip-black"></div>
    </div>

    <!-- The Paper Sheet -->
    <div class="casting-sheet">
      
      <!-- Top Section: Photo + Fields -->
      <div class="sheet-top">
        <div class="sheet-photo">
          <img src="/images/rachelchen.BSvJgRfL.webp" alt="Rachel" />
        </div>
        
        <div class="sheet-fields">
          <div class="field-row title-row">
            <span class="field-value">RACHEL</span>
          </div>
          <div class="field-row">
            <span class="field-label">Role : </span>
            <span class="field-value hot-pink">FOUNDER & DEVELOPER</span>
          </div>
          <div class="field-row">
            <span class="field-label">System : </span>
            <span class="field-value">PINK CODING CLUB / V.01</span>
          </div>
          <div class="field-row short-row">
            <span class="field-label">ID : </span>
            <span class="field-value">001</span>
          </div>
        </div>
      </div>

      <!-- Bottom Section: Streamlined Notes -->
      <div class="sheet-notes">
        
        <div class="note-box quote-box">
          <p class="handwritten-quote">"A girl can do anything <br/>AND wear heels."</p>
        </div>

        <div class="note-box mission-box">
          <p>Building spaces where hyper-femininity and hard-core logic coexist. Code is just another medium for design.</p>
        </div>

      </div>
    </div>
  </div>
</section>
<!-- HISTORY SLIDER SECTION -->
<section class="history-section">
  <div class="history-header">
    <span class="section-tag">// THE PINK CHRONICLE</span>
    <h2 class="history-title">A BRIEF HISTORY OF GIRLY TECH</h2>
    <p class="history-subtitle">From misplaced stereotypes to genuine self-expression.</p>
  </div>

  <!-- Horizontal Scroll Container -->
  <div class="history-slider">
    
    <!-- Era 01 -->
    <article class="history-card rough-start">
      <div class="card-num">01 // 1990s</div>
      <div class="card-status">ROUGH START</div>
      <h3>PURPLE MOON & BRENDA LAUREL</h3>
      <p>
        The first major push to get girls on computers. While groundbreaking in recognizing a massive missing audience, early efforts often relied on narrow assumptions about what girls cared about—focusing heavily on gossip and social climb over creation.
      </p>
      <div class="card-footer-tag">COMPUTERS ARE A GIRL'S BEST FRIEND?</div>
    </article>

    <!-- Era 02 -->
    <article class="history-card rough-start">
      <div class="card-num">02 // LATE 90s - 2000s</div>
      <div class="card-status">ROUGH START</div>
      <h3>Pink it and Shrink it</h3>
      <p>
        Tech hardware went pink, but software often fell into the "pink it and shrink it" trap. Danish company Pinkfloor created Powerbabe, a video game that aesthetics-wise was fun, but lacked real substance. Similar to Brenda's games, Powerbabe was about gossip and stereotypes. They even created an awful reality TV type gameshow surrounding it.
      </p>
      <div class="card-footer-tag">DEMONIZED FEMININITY</div>
    </article>

    <!-- Era 03 -->
    <article class="history-card positive-era">
      <div class="card-num">03 // 2000s - 2010s</div>
      <div class="card-status status-good">TURNING POINT</div>
      <h3>CREATIVE PLAY</h3>
      <p>
        Online games on sites like Winx Club (Techna anyone?), Myscene, Barbie and online dress-up portals shifted the focus toward fashion as agency, customization, and world-building. Girls weren't just consumers; they were designing, styling, and navigating digital environments on their own terms.
      </p>
      <div class="card-footer-tag">FASHION AS AGENCY</div>
    </article>

    <!-- Era 04 -->
    <article class="history-card positive-era highlight-card">
      <div class="card-num">04 // NOW</div>
      <div class="card-status status-good">THE RECODE</div>
      <h3>PINK CODING CLUB</h3>
      <p>
        Taking the aesthetic joy of fashion, makeup, and design and reclaiming it as real engineering power. Code isn't just logic—it's the ultimate creative medium for modern storytelling.
      </p>
      <div class="card-footer-tag">SYSTEM OVERRIDE</div>
    </article>

  </div>


</BaseLayout>
<style>
/* --- HISTORY SLIDER SECTION --- */
.history-section {
    padding: 100px 4%;
    background: var(--bg-black);
    border-bottom: 1px solid var(--border-gray);
}

.history-header {
    margin-bottom: 40px;
}

.section-tag {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--pink-hot);
    letter-spacing: 2px;
}

.history-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    color: var(--pink-soft);
    line-height: 0.95;
    margin: 10px 0;
}

.history-subtitle {
    font-family: monospace;
    font-size: 0.85rem;
    color: rgba(250, 206, 226, 0.7);
    text-transform: uppercase;
}

/* Horizontal Slider Container */
.history-slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    padding-bottom: 30px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
}

/* Custom Scrollbar */
.history-slider::-webkit-scrollbar {
    height: 4px;
}

.history-slider::-webkit-scrollbar-track {
    background: #111;
}

.history-slider::-webkit-scrollbar-thumb {
    background: var(--pink-hot);
}

/* Individual History Cards */
.history-card {
    flex: 0 0 380px;
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-gray);
    padding: 35px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease;
}

.history-card:hover {
    border-color: var(--pink-soft);
}

/* Card Header Meta */
.card-num {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--pink-hot);
    letter-spacing: 2px;
}

.card-status {
    display: inline-block;
    font-family: monospace;
    font-size: 0.65rem;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.05);
    color: #888;
    margin: 10px 0 20px 0;
    width: fit-content;
}

.card-status.status-good {
    background: rgba(228, 30, 129, 0.2);
    color: var(--pink-soft);
}

.history-card h3 {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.4rem;
    color: var(--pink-soft);
    line-height: 1.1;
    margin-bottom: 15px;
}

.history-card p {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(250, 206, 226, 0.8);
    text-transform: none; 
    margin-bottom: 30px;
}

.card-footer-tag {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--pink-hot);
    border-top: 1px dashed var(--border-gray);
    padding-top: 15px;
}

/* Special Highlight for PCC Card */
.history-card.highlight-card {
    border: 1px solid var(--pink-hot);
    background: linear-gradient(135deg, rgba(228, 30, 129, 0.1) 0%, rgba(0, 0, 0, 0.9) 100%);
}


@media (max-width: 768px) {
    .history-card {
        flex: 0 0 300px;
        padding: 25px;
    }
 .sheet-top { flex-direction: column; }
    .sheet-photo { flex: 0 0 auto; width: 60%; margin: 0 auto; }
    .clip-left { left: 10%; }
    .clip-right { right: 10%; }
    .mission-box p { max-width: 100%; }
}
/* --- FOUNDER SECTION: CASTING CARD --- */
.casting-section {
    padding: 120px 4%;
    background: var(--bg-black);
    display: flex;
    justify-content: center;
}

.casting-board {
    position: relative;
    max-width: 800px; 
    width: 100%;
    margin-top: 20px;
}

/* CSS Binder Clips */
.clip {
    position: absolute;
    top: -25px;
    width: 40px;
    height: 50px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.clip-left { left: 15%; }
.clip-right { right: 15%; }

.clip-metal {
    width: 24px;
    height: 25px;
    border: 3px solid #888;
    border-bottom: none;
    border-radius: 5px 5px 0 0;
}

.clip-black {
    width: 40px;
    height: 25px;
    background: #111;
    border-radius: 2px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.5);
}

/* The Paper Sheet */
.casting-sheet {
    background: #f4f4f4; 
    color: #111;         
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.sheet-top {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}

.sheet-photo {
    flex: 0 0 40%; 
    border: 1px solid #111;
    padding: 2px;
    background: #fff;
}

.sheet-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3/4;
    display: block;
}

.sheet-fields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding-top: 10px;
}

.field-row {
    border: 1px solid #111;
    padding: 8px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    background: #fff;
}

.title-row {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    padding: 12px;
}

.field-row.short-row {
    width: 40%;
}

.field-label {
    font-weight: 600;
    color: #444;
}

.field-value.hot-pink {
    color: var(--pink-hot, #e41e81);
    font-weight: 700;
}

/* Bottom: Streamlined Notes */
.sheet-notes {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.note-box {
    border: 1px solid #111;
    background: #fff;
    padding: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.quote-box {
    padding: 50px 30px;
}

.handwritten-quote {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--pink-hot, #e41e81);
    line-height: 1.1;
    text-align: center;
    transform: rotate(-2deg);
}

.mission-box {
    background: transparent;
    padding: 20px;
    border-style: dashed;
}

.mission-box p {
    font-family: monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
    text-transform: uppercase;
    color: #444;
    max-width: 80%;
}



</style>
