---
// src/layouts/BaseLayout.astro
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';


const { 
  title = "Pink Coding Club | Free Creative Tech & Coding Camps for Girls", 
  description = "Pink Coding Club (P.C.C.) blends computer science with art, fashion, and design. 100% free coding programs empowering girls and non-binary youth.",
  version, 
  isIndex = false, 
  showHero = false 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    
    <!-- Core SEO -->
    <meta name="description" content={description}>
    <meta name="keywords" content="free coding camp for girls, non-binary coding programs, aesthetic coding, fashion tech, free STEM camps">
    
    <!-- Open Graph (Discord, iMessage, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google JSON-LD Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Pink Coding Club",
        "url": "https://pinkcodingclub.com",
        "description": "Free coding camps and creative tech programs for girls and non-binary youth, blending computer science with art, fashion, and trauma-informed design.",
        "isAccessibleForFree": true,
        "teaches": "Computer Science, Creative Tech, Web Development",
        "audience": {
          "@type": "Audience",
          "audienceType": "Girls and non-binary youth"
        }
      }
    </script>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Crimson+Text:ital,wght@0,700;1,700&family=Reenie+Beanie&display=swap&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link 
      rel="icon" 
      type="image/svg+xml" 
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23000000'/><text x='50%' y='55%' dominant-baseline='central' text-anchor='middle' font-family='sans-serif' font-size='38' font-weight='900' fill='%23facee2' letter-spacing='-2px'>P.C.C.</text></svg>" 
    />
    <slot name="head" /> 
</head>
<body class={isIndex ? "index-page" : "sub-page"}>

    <Navbar />

    {showHero && (
      <Hero isIndex={isIndex} version={version}>
        <slot name="hero-title" slot="hero-title" />
      </Hero>
    )}

    <main>
        <slot />
    </main>

    <footer class="copyright-footer">
        <div class="footer-left">&copy; {new Date().getFullYear()} PINK CODING CLUB. ALL RIGHTS RESERVED.</div>
        <div class="footer-right">
            EST. 2026 // V.01 "RECODING FEMININITY"<br>
            <a href="" target="_blank" style="text-decoration:none; color: var(--border-gray);">BUILT BY RACHEL CHEN</a>
        </div>
    </footer>

</body>
</html>
