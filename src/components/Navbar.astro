---
// src/components/Navbar.astro
const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url; 

const formatUrl = (path) => `${base.replace(/\/$/, '')}/${path}`;
---

<nav>
  <div class="logo">
    <a href={base} style="text-decoration: none; color: inherit;">P.C.C.</a>
  </div>

  <!-- Universal Hamburger Menu -->
  <div class="menu-toggle" id="menu-btn">
    <div class="hamburger-lines">
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<!-- Universal Full-Screen Overlay -->
<div class="nav-overlay" id="nav-overlay">
  <div class="overlay-container">
    <div class="overlay-top-bar">
      <div class="close-menu" id="close-menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </div>
    </div>
    
    <div class="overlay-content">
      <!-- Secondary info -->
      <div class="overlay-secondary">
        <div class="secondary-group">
          <a href={base}>INDEX</a>
          <p>PRESS</p>
          <p>CASTING</p>
        </div>
        <div class="secondary-group bottom">
          <a href={formatUrl('diary#diary')}>DIARY</a>
          <a href={formatUrl('diary#business')}>BUSINESS</a>
          <a href={formatUrl('diary#contact')}>CONTACT</a>
        </div>
      </div>

      <!-- Massive primary links -->
      <div class="overlay-nav-links">
        <a href={formatUrl('pcc-world')}>P.C.C. WORLD</a>
        <a href={formatUrl('curriculum')}>CURRICULUM</a>
        <a href={formatUrl('the-club')}>THE CLUB</a>
        <span class="nav-sub-label">FRIEND OF THE HOUSE</span>
      </div>
    </div>
  </div>
</div>

<script>
  /* --- ISLAND LOGIC --- */
  let scrollPosition = 0;

  const initMenu = () => {
    const menuBtn = document.getElementById('menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const overlay = document.getElementById('nav-overlay');

    if (!menuBtn || !overlay || !closeBtn) return;

    const toggleMenu = (state) => {
      const isActive = state !== undefined ? state : !overlay.classList.contains('active');

      if (isActive) {
        scrollPosition = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollPosition}px`;
        document.body.style.width = '100%';
        document.body.style.overflow = 'hidden';

        document.querySelector('nav')?.classList.remove('nav-hidden');
      } else {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollPosition);
      }

      menuBtn.classList.toggle('active', isActive);
      overlay.classList.toggle('active', isActive);
    };

    const newMenuBtn = menuBtn.cloneNode(true);
    menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
    
    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);

    newMenuBtn.addEventListener('click', () => toggleMenu());
    newCloseBtn.addEventListener('click', () => toggleMenu(false));

    document.querySelectorAll('.overlay-content a').forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  };

  /* --- SMART SCROLL LOGIC --- */
  let lastScrollY = window.scrollY;

  const handleScroll = () => {
    const nav = document.querySelector('nav');
    const overlay = document.getElementById('nav-overlay');
    
    if (!nav) return;
    if (overlay && overlay.classList.contains('active')) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      nav.classList.add('nav-hidden');
    } else {
      nav.classList.remove('nav-hidden');
    }

    lastScrollY = currentScrollY;
  };

  initMenu();
  window.removeEventListener('scroll', handleScroll);
  window.addEventListener('scroll', handleScroll);

  document.addEventListener('astro:after-swap', () => {
    initMenu();
    lastScrollY = window.scrollY; 
  });

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
  });
</script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    background-color: var(--bg-black);
}

body {
    background-color: var(--bg-black);
    color: var(--pink-soft);
    text-transform: uppercase;
}

/* Navigation - Minimal & Wide */
nav {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 4%;
    padding-top: max(20px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--border-gray, rgba(255,255,255,0.1));
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    transition: transform 0.4s cubic-bezier(0.85, 0, 0.15, 1);
}

nav.nav-hidden {
    transform: translateY(-100%);
}

.logo {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.2rem;
    letter-spacing: -1px;
}

.menu-toggle {
    display: flex; 
    cursor: pointer;
    z-index: 1002;
    position: relative;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: flex-end;
}

.hamburger-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    align-items: flex-end;
}

.hamburger-lines span {
    display: block;
    height: 1.5px;
    background: var(--pink-soft, #fff);
    transition: all 0.4s cubic-bezier(0.85, 0, 0.15, 1);
}

.hamburger-lines span:nth-child(1) { width: 100%; }
.hamburger-lines span:nth-child(2) { width: 60%; }

.menu-toggle:hover .hamburger-lines span:nth-child(2) {
    width: 100%;
}

.menu-toggle.active { opacity: 0; pointer-events: none; }

/* Overlay Layout */
.nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: var(--bg-black, #000);
    z-index: 1001;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition: clip-path 0.7s cubic-bezier(0.77, 0, 0.175, 1), visibility 0.7s;
}

.nav-overlay.active {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
}

.overlay-container {
    padding: max(30px, env(safe-area-inset-top)) 4% 40px;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.overlay-top-bar {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
}

.close-menu {
    cursor: pointer;
    transition: transform 0.3s ease, color 0.3s ease;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--pink-soft, #fff);
}

.close-menu:hover {
    color: var(--pink-hot, #ff69b4);
    transform: rotate(90deg);
}

.overlay-content {
    display: flex;
    flex: 1;
    margin-top: 40px;
    justify-content: space-between;
}

/* Secondary Info Column */
.overlay-secondary {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    padding-bottom: 20px;
    flex: 0 0 220px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease 0.5s, transform 0.5s ease 0.5s;
}

.nav-overlay.active .overlay-secondary {
    opacity: 1;
    transform: translateY(0);
}

.secondary-group p,
.secondary-group a {
    display: block;
    margin-bottom: 12px;
    cursor: pointer;
    transition: color 0.2s;
    text-decoration: none; 
    color: inherit;        
}

.secondary-group p:hover,
.secondary-group a:hover { 
    color: var(--text-white, #fff); 
}

/* Primary Nav Links Column */
.overlay-nav-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 15px;
    width: 100%;
}

/* Base states for smooth entrance transitions */
.overlay-nav-links a,
.overlay-nav-links .nav-sub-label {
    opacity: 0;
    transform: translateY(30px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                color 0.4s ease;
}

/* Entrance Stagger Animations */
.nav-overlay.active .overlay-nav-links a:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 0.2s; }
.nav-overlay.active .overlay-nav-links a:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 0.3s; }
.nav-overlay.active .overlay-nav-links a:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 0.4s; }
.nav-overlay.active .overlay-nav-links .nav-sub-label  { opacity: 0.4; transform: translateY(0); transition-delay: 0.5s; }

.overlay-nav-links a {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2.5rem, 10vw, 8rem);
    line-height: 0.9;
    text-decoration: none;
    letter-spacing: -2px;
    text-align: right;
}

.overlay-nav-links a:nth-child(1) { color: #e41e81; }
.overlay-nav-links a:nth-child(2) { color: #facee2; }
.overlay-nav-links a:nth-child(3) { color: var(--text-white, #fff); }

.nav-sub-label {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(0.9rem, 2vw, 1.4rem);
    letter-spacing: 2px;
    color: var(--pink-soft);
    margin-top: 20px;
    text-align: right;
    text-transform: uppercase;
    cursor: pointer; 
}

.nav-overlay.active .overlay-nav-links .nav-sub-label:hover {
    transform: translateX(-15px);
    opacity: 1; 
}

/* Primary Links Hover */
.nav-overlay.active .overlay-nav-links a:hover {
    transform: translateX(-15px);
    opacity: 0.7;
}



/* Mobile Adjustments for the Overlay */
@media (max-width: 834px) {
    .overlay-content {
        flex-direction: column-reverse; 
        justify-content: flex-end;
        gap: 40px;
    }
    
    .overlay-secondary {
        flex-direction: row; 
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 30px;
        padding-bottom: 0;
    }

    .overlay-nav-links {
        align-items: flex-start;
    }

    .overlay-nav-links a,
    .nav-sub-label {
        text-align: left;
    }

    .nav-overlay.active .overlay-nav-links a:hover,
    .nav-overlay.active .overlay-nav-links .nav-sub-label:hover {
        transform: translateX(15px);
    }

    .overlay-nav-links a {
        letter-spacing: -1px;
    }
}
</style>
