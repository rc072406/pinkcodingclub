---
// src/components/Navbar.astro
const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url; 

const cleanPath = pathname
  .replace(base, "")
  .replace(/\/$/, "") || "";

const isManifesto = cleanPath === 'manifesto';
const isJoin = cleanPath === 'join';
const isCurriculum = cleanPath === 'curriculum' || cleanPath === 'web-design';

const formatUrl = (path) => `${base.replace(/\/$/, '')}/${path}`;
---

<nav>
  <div class="logo">
    <a href={base} style="text-decoration: none; color: inherit;">P.C.C.</a>
  </div>
  <div class="nav-links">
    <a href={formatUrl('manifesto')} class={isManifesto ? 'active' : ''}>MANIFESTO</a>
    <a href={formatUrl('curriculum')} class={isCurriculum ? 'active' : ''}>CURRICULUM</a>
    <a href={formatUrl('join')} class={isJoin ? 'active' : ''}>JOIN</a>
  </div>

  <div class="menu-toggle" id="mobile-menu-btn">
    <span></span><span></span><span></span>
  </div>
</nav>

<div class="mobile-overlay" id="mobile-overlay">
  <div class="mobile-nav-links">
    <a href={formatUrl('manifesto')} class={isManifesto ? 'active' : ''}>MANIFESTO</a>
    <a href={formatUrl('curriculum')} class={isCurriculum ? 'active' : ''}>CURRICULUM</a>
    <a href={formatUrl('join')} class={isJoin ? 'active' : ''}>JOIN</a>
  </div>
</div>

<script>
  /* --- ISLAND LOGIC --- */
  let scrollPosition = 0;

  const initMenu = () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const overlay = document.getElementById('mobile-overlay');

    if (!menuBtn || !overlay) return;

    const toggleMenu = (state) => {
      const isActive = state !== undefined ? state : !overlay.classList.contains('active');

      if (isActive) {
        // True iOS Safari Scroll Lock
        scrollPosition = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollPosition}px`;
        document.body.style.width = '100%';
        document.body.style.overflow = 'hidden';

        document.querySelector('nav')?.classList.remove('nav-hidden');
      } else {
        // Restore scroll position
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollPosition);
      }

      menuBtn.classList.toggle('active', isActive);
      overlay.classList.toggle('active', isActive);
    };

    // Prevent duplicate event listeners when Astro swaps pages
    const newMenuBtn = menuBtn.cloneNode(true);
    menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);

    newMenuBtn.addEventListener('click', () => toggleMenu());

    // Close when clicking links
    document.querySelectorAll('.mobile-nav-links a').forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  };

  /* --- SMART SCROLL LOGIC --- */
  let lastScrollY = window.scrollY;

  const handleScroll = () => {
    const nav = document.querySelector('nav');
    const overlay = document.getElementById('mobile-overlay');
    
    if (!nav) return;
    
    // Do not hide navbar if mobile menu is open
    if (overlay && overlay.classList.contains('active')) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      nav.classList.add('nav-hidden');
    } else {
      nav.classList.remove('nav-hidden');
    }

    lastScrollY = currentScrollY;
  };

  // Initial setup
  initMenu();
  window.removeEventListener('scroll', handleScroll);
  window.addEventListener('scroll', handleScroll);

  // Re-run setup after a page swap
  document.addEventListener('astro:after-swap', () => {
    initMenu();
    lastScrollY = window.scrollY; 
  });

  // Force unlock scrolling right before Astro leaves the page
  document.addEventListener('astro:before-preparation', () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
  });
</script>

<style>
/* Mobile Toggle Styles */
.menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    z-index: 1002;
    position: relative;
}

.menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    background: #facee2;
    transition: 0.3s cubic-bezier(0.85, 0, 0.15, 1);
}

/* Animation to 'X' */
.menu-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 6px); background: #e41e81; }
.menu-toggle.active span:nth-child(2) { opacity: 0; }
.menu-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -6px); background: #e41e81; }

/* Overlay Styles - SAFARI COMPOSITOR FIX */
.mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1001;
    
    /* Reveal overlay using clip-path instead of moving layer coordinates */
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition: clip-path 0.5s cubic-bezier(0.85, 0, 0.15, 1), visibility 0.5s;
}

.mobile-overlay.active {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
}

.mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 25px;
    text-align: center;
}

.mobile-nav-links a {
    font-family: 'Archivo Black', sans-serif;
    font-size: 3rem;
    color: #facee2;
    text-decoration: none;
    letter-spacing: -2px;
}

/* Gradient Effect on Hover */
.mobile-nav-links a:hover, .mobile-nav-links a.active {
    background: linear-gradient(90deg, #facee2 0%, #f3a6c9 50%, #e41e81 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* Show toggle on mobile */
@media (max-width: 768px) {
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
}
 
:root {
    --bg-black: #000000;
    --text-white: #ffffff;
    --border-gray: #333333;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    background-color: #000000; /* Safari status bar color fallback */
}

body {
    background-color: var(--bg-black);
    color: #facee2;
    font-family: 'Inter', sans-serif;
    text-transform: uppercase;
}

/* Navigation - Minimal & Wide */
nav {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 4%;
    padding-top: max(20px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--border-gray);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    
    /* Safari Fixes */
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    
    /* Scroll Animation */
    transition: transform 0.4s cubic-bezier(0.85, 0, 0.15, 1);
}

/* Class applied by JS to hide navbar */
nav.nav-hidden {
    transform: translateY(-100%);
}

.logo {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.2rem;
    letter-spacing: -1px;
}

/* Navbar Links & Hovers */
.nav-links a {
    color: #facee2;
    text-decoration: none;
    font-size: 0.7rem;
    margin-left: 30px;
    letter-spacing: 2px;
    font-weight: 900;
    transition: all 0.4s ease;
    display: inline-block;
}

.nav-links a:hover {
    background: linear-gradient(90deg, #facee2 0%, #f3a6c9 50%, #e41e81 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transform: translateY(-1px);
    text-shadow: 0 0 10px rgba(228, 30, 129, 0.2);
}

.nav-links a.active {
    background: linear-gradient(90deg, #facee2 0%, #f3a6c9 50%, #e41e81 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
}
</style>
