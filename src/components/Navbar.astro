---
// src/components/Navbar.astro
const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url; 

const cleanPath = pathname
  .replace(base, "")
  .replace(/\/$/, "") || "";

const isManifesto = cleanPath === 'manifesto';
const isJoin = cleanPath === 'join';
const isCurriculum = cleanPath === 'curriculum' || cleanPath === 'web-design';

const formatUrl = (path) => `${base.replace(/\/$/, '')}/${path}`;
---

<nav>
  <div class="logo">
    <a href={base} style="text-decoration: none; color: inherit;">P.C.C.</a>
  </div>
  <div class="nav-links">
    <a href={formatUrl('manifesto')} class={isManifesto ? 'active' : ''}>MANIFESTO</a>
    <a href={formatUrl('curriculum')} class={isCurriculum ? 'active' : ''}>CURRICULUM</a>
    <a href={formatUrl('join')} class={isJoin ? 'active' : ''}>THE CLUB</a>
  </div>

  <div class="menu-toggle" id="mobile-menu-btn">
    <div class="hamburger-lines">
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<div class="mobile-overlay" id="mobile-overlay">
  <div class="overlay-container">
    <div class="close-menu" id="close-menu-btn">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </div>
    
    <div class="overlay-content">
      <!-- Left side: Secondary info (Matches Reference Image) -->
      <div class="overlay-secondary">
        <div class="secondary-group">
          <p>SUBSCRIBE</p>
        </div>
        <div class="secondary-group">
          <p>SUBMISSION</p>
          <p>PULL-LETTER</p>
        </div>
        <div class="secondary-group">
          <p>ABOUT</p>
          <p>BUSINESS</p>
          <p>CONTACT</p>
        </div>
      </div>

      <!-- Right side: Massive primary links -->
      <div class="mobile-nav-links">
        <a href={formatUrl('manifesto')} class={isManifesto ? 'active' : ''}>MANIFESTO</a>
        <a href={formatUrl('curriculum')} class={isCurriculum ? 'active' : ''}>CURRICULUM</a>
        <a href={formatUrl('join')} class={isJoin ? 'active' : ''}>JOIN</a>
      </div>
    </div>
  </div>
</div>

<script>
  /* --- ISLAND LOGIC --- */
  let scrollPosition = 0;

  const initMenu = () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const overlay = document.getElementById('mobile-overlay');

    if (!menuBtn || !overlay || !closeBtn) return;

    const toggleMenu = (state) => {
      const isActive = state !== undefined ? state : !overlay.classList.contains('active');

      if (isActive) {
        // True iOS Safari Scroll Lock
        scrollPosition = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollPosition}px`;
        document.body.style.width = '100%';
        document.body.style.overflow = 'hidden';

        document.querySelector('nav')?.classList.remove('nav-hidden');
      } else {
        // Restore scroll position
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollPosition);
      }

      menuBtn.classList.toggle('active', isActive);
      overlay.classList.toggle('active', isActive);
    };

    const newMenuBtn = menuBtn.cloneNode(true);
    menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
    
    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);

    newMenuBtn.addEventListener('click', () => toggleMenu());
    newCloseBtn.addEventListener('click', () => toggleMenu(false));

    document.querySelectorAll('.mobile-nav-links a').forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  };

  /* --- SMART SCROLL LOGIC --- */
  let lastScrollY = window.scrollY;

  const handleScroll = () => {
    const nav = document.querySelector('nav');
    const overlay = document.getElementById('mobile-overlay');
    
    if (!nav) return;
    if (overlay && overlay.classList.contains('active')) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      nav.classList.add('nav-hidden');
    } else {
      nav.classList.remove('nav-hidden');
    }

    lastScrollY = currentScrollY;
  };

  initMenu();
  window.removeEventListener('scroll', handleScroll);
  window.addEventListener('scroll', handleScroll);

  document.addEventListener('astro:after-swap', () => {
    initMenu();
    lastScrollY = window.scrollY; 
  });

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
  });
</script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { background-color: var(--bg-black); }

body {
    background-color: var(--bg-black);
    color: var(--pink-soft);
    text-transform: uppercase;
}


nav {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 5%;
    padding-top: max(20px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--border-gray);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    transition: transform 0.4s cubic-bezier(0.85, 0, 0.15, 1);
}

nav.nav-hidden {
    transform: translateY(-100%);
}

.logo {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.2rem;
    letter-spacing: -1px;
}

.nav-links {
    display: flex;
    gap: 40px;
}

.nav-links a {
    color: var(--pink-soft);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 2px;
    font-weight: 900;
    transition: all 0.4s ease;
}

.nav-links a:hover, .nav-links a.active {
    background: linear-gradient(90deg, var(--pink-soft) 0%, var(--pink-mid) 50%, var(--pink-hot) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.menu-toggle {
    display: none;
    cursor: pointer;
    z-index: 1002;
    position: relative;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: flex-end;
}

.hamburger-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    align-items: flex-end;
}

.hamburger-lines span {
    display: block;
    height: 1.5px;
    background: var(--pink-soft);
    transition: all 0.4s cubic-bezier(0.85, 0, 0.15, 1);
}

.hamburger-lines span:nth-child(1) { width: 100%; }
.hamburger-lines span:nth-child(2) { width: 60%; }

.menu-toggle:hover .hamburger-lines span:nth-child(2) { width: 100%; }
.menu-toggle.active { opacity: 0; pointer-events: none; }

/* --- OVERLAY LAYOUT --- */
.mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: var(--bg-black);
    z-index: 1001;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition: clip-path 0.7s cubic-bezier(0.77, 0, 0.175, 1), visibility 0.7s;
}

.mobile-overlay.active {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
}

.overlay-container {
    padding: max(30px, env(safe-area-inset-top)) 5% 5vh;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.close-menu {
    align-self: flex-start;
    color: var(--pink-soft);
    cursor: pointer;
    transition: transform 0.4s ease, color 0.3s ease;
    padding: 10px;
    margin-left: -10px;
}

.close-menu:hover {
    color: var(--pink-hot);
    transform: rotate(90deg);
}

.overlay-content {
    display: flex;
    flex: 1;
    margin-top: 4vh;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

/* Secondary Info */
.overlay-secondary {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 2vh;
}

.secondary-group {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1.6;
}

.secondary-group p {
    margin-bottom: 12px;
    cursor: pointer;
    color: var(--pink-soft);
    transition: color 0.3s ease;
}

.secondary-group p:hover { color: var(--text-white); }

/* Massive Links */
.mobile-nav-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 1vh;
}

.mobile-nav-links a {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.85;
    color: var(--pink-soft);
    text-decoration: none;
    letter-spacing: -3px;
    text-align: right;
    transition: all 0.4s ease;
}

.mobile-nav-links a:nth-child(1) { color: #8A2222; }
.mobile-nav-links a:nth-child(2) { color: #D5B980; }
.mobile-nav-links a:nth-child(3) { color: var(--text-white); }

.mobile-nav-links a:hover, .mobile-nav-links a.active {
    color: var(--pink-hot);
    transform: translateX(-15px);
}

/* --- RESPONSIVE MOBILE ADJUSTMENTS --- */
@media (max-width: 900px) {
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
    
    .overlay-content {
        flex-direction: column;
        justify-content: flex-start;
        gap: 6vh;
    }

    .mobile-nav-links {
        align-items: flex-start;
        margin-top: 2vh;
    }

    .mobile-nav-links a {
        font-size: clamp(3.5rem, 14vw, 6rem);
        letter-spacing: -2px;
        text-align: left;
    }

    .mobile-nav-links a:hover, .mobile-nav-links a.active {
        transform: translateX(10px); 
    }

    .overlay-secondary {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 40px;
        justify-content: flex-start;
        margin-top: auto; 
        padding-bottom: 20px;
    }
}
</style>
