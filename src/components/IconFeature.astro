---
// src/components/IconFeature.astro
// Usage: <IconFeature name="Claire Davison" role="ABT Ballerina" image="/images/clairedavison.jpg" url="/stories/claire" />

const { 
  name = "CLAIRE DAVISON", 
  role = "ABT BALLERINA",
  image = "/images/clairedavison.jpg",
  url = "/stories/claire-davison"
} = Astro.props;
---

<section class="icon-section">
  <div class="icon-header">
    <span class="section-tag">// REAL ICONS. REAL STORIES.</span>
  </div>

  <article class="icon-grid">

    <!-- Image Side  -->
    <div class="icon-visual">
      <img src={image} alt={`Portrait of ${name}`} class="icon-img" />
    </div>

    <!-- Content Side -->
    <div class="icon-editorial">
      <div class="file-meta">
        <span class="leak-tag">STATUS: UNLOCKED</span>
        <span class="barcode">||| | |||| | |||</span>
      </div>
      
      <h2 class="icon-title">MEET<br/>{name}</h2>
      <h3 class="icon-role">{role}</h3>
      
      <p class="icon-snippet">
        Read all about her pilgrimage to discovering herself as an artist. A raw look into the pain, the breakthrough, and the journey to finding her true love: storytelling.
      </p>
      
      <div class="action-row">
        <a href={url} class="cta-btn">READ THE STORY</a>
      </div>
    </div>
  </article>
</section>

<style>
  .icon-section {
    padding: 100px 4%;
    background: var(--bg-black);
    border-bottom: 1px solid var(--border-gray);
    position: relative;
  }

  .icon-header {
    margin-bottom: 40px;
  }

  .section-tag {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--pink-hot);
    letter-spacing: 2px;
  }

  .icon-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    max-width: 1200px;
    border: 1px solid var(--border-gray);
    background: rgba(255, 255, 255, 0.02);
  }

  .icon-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    border-right: 1px solid var(--border-gray);
    overflow: hidden;
  }

  .icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon-editorial {
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .file-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    color: var(--pink-hot);
  }

  .leak-tag {
    font-family: monospace;
    font-size: 0.75rem;
    background: rgba(228, 30, 129, 0.1);
    padding: 4px 8px;
  }

  .icon-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--pink-soft);
    line-height: 0.9;
    margin-bottom: 10px;
  }

  .icon-role {
    font-family: monospace;
    font-size: 1rem;
    color: #fff;
    letter-spacing: 2px;
    margin-bottom: 30px;
  }

  .icon-snippet {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    text-transform: none;
    margin-bottom: 40px;
    max-width: 90%;
  }

  .action-row {
    margin-top: auto;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .icon-grid {
      grid-template-columns: 1fr;
    }
    .icon-visual {
      border-right: none;
      border-bottom: 1px solid var(--border-gray);
      min-height: 400px;
    }
    .icon-editorial {
      padding: 40px 20px;
    }
  }
</style>
