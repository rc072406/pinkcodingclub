---
// src/components/IconFeature.astro
// Usage: <IconFeature name="Claire Davison" role="ABT Ballerina" image="/images/clairedavison.jpg" url="/stories/claire" />

const { 
  name = "Claire Davison", 
  role = "ABT Ballerina",
  image = "/images/clairedavison.jpg",
  url = "/stories/claire-davison"
} = Astro.props;
---

<section class="icon-section">
  <div class="casting-sheet">
    
    <!-- Header -->
    <h1 class="campaign-title">The Real Icons campaign</h1>
    
    <!-- Main Grid -->
    <div class="sheet-table">
      
      <!-- Row 1: Meta -->
      <div class="table-row border-bottom">
        <div class="table-cell border-right">
          <span class="label">Name:</span> <span class="handwritten">{name}</span>
        </div>
        <div class="table-cell">
          <span class="label">Look:</span> <span class="handwritten">{role}</span>
        </div>
      </div>

      <!-- Row 2: Visuals & Details -->
      <div class="table-row">
        <!-- Left Column: Main Image -->
        <div class="table-cell border-right image-cell">
          <img src={image} alt={`Casting polaroid of ${name}`} class="casting-img" />
        </div>
        
        <!-- Right Column: Stacked Boxes -->
        <div class="details-col">
          
          <div class="detail-box">
            <span class="handwritten-label">status:</span>
            <div class="handwritten-note">unlocked</div>
          </div>
          
          <div class="detail-box border-top border-bottom">
            <span class="label">Focus:</span> <span class="handwritten">storytelling</span>
          </div>
          
          <div class="detail-box">
            <span class="handwritten-label">vibe:</span>
            <div class="handwritten-note">whimsical roots</div>
          </div>

        </div>
      </div>
    </div>

    <!-- Notes Section -->
    <div class="notes-section">
      <div class="handwritten-label">notes:</div>
      <div class="notes-list">
        <p>- read all about her pilgrimage to discovering herself as an artist.</p>
        <p>- from rediscovering her clown roots to creating whimsical designs on the web.</p>
        <p>- a raw look into the pain, the breakthrough, and finding her true love.</p>
      </div>
    </div>

    <!-- Footer Action -->
    <div class="footer-cta">
      <span class="asterisk">*</span>
      <a href={url} class="handwritten-link">Read the story...</a>
    </div>

  </div>
</section>

<style>
  .icon-section {
    padding: 80px 4%;
    background: var(--bg-black, #0a0a0a); 
  }


  .casting-sheet {
    background: #ffffff;
    color: #000000;
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 30px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .campaign-title {
    font-family: 'Reenie Beanie', cursive;
    font-size: 3.5rem;
    font-weight: normal;
    margin: 0 0 15px 0;
    line-height: 1;
    color: #111;
  }

  /* Table Structure */
  .sheet-table {
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    margin-bottom: 40px;
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .border-bottom {
    border-bottom: 1px solid #000;
  }
  .border-top {
    border-top: 1px solid #000;
  }
  .border-right {
    border-right: 1px solid #000;
  }

  .table-cell {
    padding: 15px 20px;
    display: flex;
    align-items: center;
  }

  .label {
    font-weight: bold;
    font-size: 1.1rem;
    text-transform: capitalize;
  }

  .handwritten {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2.2rem;
    color: #222;
    margin-left: 10px;
    line-height: 1;
    transform: translateY(2px);
  }

  /* Image Column */
  .image-cell {
    background: #f4f4f4; /* Mimics the studio backdrop from the image */
    padding: 30px;
    justify-content: center;
  }

  .casting-img {
    width: 100%;
    max-width: 280px;
    height: auto;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  /* Right Details Column */
  .details-col {
    display: flex;
    flex-direction: column;
  }

  .detail-box {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .detail-box.border-top.border-bottom {
    flex: 0 0 auto;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
  }

  .handwritten-label {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2rem;
    color: #111;
    line-height: 1;
  }

  .handwritten-note {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2.2rem;
    color: #333;
    margin-top: 10px;
    margin-left: 20px;
    transform: rotate(-1deg);
  }

  /* Notes Section */
  .notes-section {
    margin-bottom: 50px;
    padding: 0 10px;
  }

  .notes-list {
    margin-top: 15px;
    margin-left: 10px;
  }

  .notes-list p {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2.2rem;
    color: #111;
    margin: 8px 0;
    line-height: 1.1;
  }

  /* Footer CTA */
  .footer-cta {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 0 10px;
  }

  .asterisk {
    font-family: 'Reenie Beanie', cursive;
    font-size: 3rem;
    line-height: 0.7;
    color: #000;
  }

  .handwritten-link {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2.4rem;
    color: var(--pink-hot, #ff2a85);
    text-decoration: none;
    line-height: 1.2;
    transition: opacity 0.2s ease;
  }

  .handwritten-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-decoration-style: wavy;
  }

  /* Responsive Adjustments */
  @media (max-width: 700px) {
    .table-row {
      grid-template-columns: 1fr;
    }
    .border-right {
      border-right: none;
      border-bottom: 1px solid #000;
    }
    .campaign-title {
      font-size: 2.8rem;
    }
  }
</style>
