---
// src/components/Hero.astro
const { isIndex = false, version = "V.01" } = Astro.props;
---

<section class={`hero ${isIndex ? 'index-hero' : 'sub-hero'}`}>
    
    <p class="version-tag">{version}</p>
    
    <div class="hero-container">
        {isIndex ? (
            <>
                <h1>PINK<br>CODING<br>CLUB</h1>
                <div class="hero-sub">
                    <p class="tagline">Hyper-technical education for the girls and non-binary icons who lead the culture. No compromises.</p>
                    <a href="/the-club" class="typewriter-cta hero-cta" data-text="ENTER CLUB">
                        <span class="typewriter-text"></span><span class="cursor"></span>
                    </a>
                </div>
            </>
        ) : (
            <h1><slot name="hero-title" /></h1>
        )}
    </div>
</section>

<style>
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 100px 4% 60px 4%;
        border-bottom: 1px solid var(--border-gray);
        overflow: hidden;
        background: black;
        will-change: transform; 
        -webkit-backface-visibility: hidden;
        min-height: 100vh;  
        min-height: 100svh;
        overscroll-behavior: none;
    }

    .hero-container, .version-tag {
        position: relative;
        z-index: 2;
    }

    .version-tag {
        font-size: 0.7rem;
        letter-spacing: 5px;
        margin-bottom: 10px;
    }

    .index-hero h1 {
        font-family: 'Archivo Black', sans-serif;
        font-size: clamp(4rem, 15vw, 12rem);
        line-height: 0.81;
        letter-spacing: -0.045em;
        margin-top: 10px;
        margin-bottom: 35px;
        text-transform: uppercase;
    }

    .sub-hero h1 {
        font-family: 'Archivo Black', sans-serif;
        font-size: clamp(3.5rem, 12vw, 9.5rem);
        line-height: 0.82;
        letter-spacing: -0.04em;
    }


    .typewriter-cta {
        display: inline-flex;
        align-items: center;
        font-family: monospace, monospace;
        font-size: 1rem;
        letter-spacing: 0.05em;
        color: #fff;
        text-decoration: none;
        background: transparent;
        padding: 4px 0;
        width: fit-content;
    }

    .typewriter-cta::before {
        content: "▶";
        margin-right: 8px;
        font-size: 0.85em;
    }

    .cursor {
        display: inline-block;
        width: 8px;
        height: 1em;
        background-color: #fff;
        margin-left: 2px;
        animation: blink 1s infinite;
        vertical-align: middle;
    }

    @keyframes blink {
        0%, 50% { opacity: 1; }
        50.1%, 100% { opacity: 0; }
    }

    .hero-cta {
        display: block;
        margin-left: auto; 
        width: fit-content;
    }

    @media (max-width: 768px) {
        .hero {
            min-height: auto;
            padding-top: calc(90px + env(safe-area-inset-top, 0px));
            padding-bottom: 40px;
            padding-left: 4%;
            padding-right: 4%;
            justify-content: flex-start;
        }

        .index-hero h1 {
            font-size: clamp(4.2rem, 19.5vw, 8rem);
            line-height: 0.82;
            letter-spacing: -0.035em;
            margin-bottom: 28px;
        }

        .sub-hero h1 {
            font-size: clamp(3rem, 12vw, 6rem);
            line-height: 0.83;
            letter-spacing: -0.03em;
        }

        .hero-cta {
            margin-top: 40px;
            margin-left: 0 !important;        
            margin-right: auto !important;    
            align-self: flex-start;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cta = document.querySelector(".typewriter-cta");
        if (!cta) return;

        const textSpan = cta.querySelector(".typewriter-text");
        const fullText = cta.getAttribute("data-text") || "";
        let charIndex = 0;
        let isTyping = false;

        function typeWriter() {
            if (charIndex < fullText.length) {
                textSpan.textContent += fullText.charAt(charIndex);
                charIndex++;
                setTimeout(typeWriter, 80); // Speed of typing per letter (ms)
            }
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isTyping) {
                    isTyping = true;
                    typeWriter();
                }
            });
        }, { threshold: 0.5 });

        observer.observe(cta);
    });
</script>
