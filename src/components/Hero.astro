---
// src/components/Hero.astro
const { isIndex = false, version = "V.01" } = Astro.props;

---

<section class=`hero ${isIndex ? 'index-hero' : 'sub-hero'}`>
    <div class="glass-layer">
        <div class="glass-shard shard-1"></div>
        <div class="glass-shard shard-2"></div>
        <div class="glass-shard shard-3"></div>
    </div>
    <p class="version-tag">{version}</p>
    
    <div class="hero-container">
        {isIndex ? (
            <>
                <h1>PINK<br>CODING<br>CLUB</h1>
                <div class="hero-sub">
                    <p class="tagline">Hyper-technical education for the girls and non-binary icons who lead the culture. No compromises.</p>
                  <a href="/join" class="cta-btn hero-cta">ENTER CLUB</a>
                </div>
            </>
        ) : (
            <h1><slot name="hero-title" /></h1>
        )}
    </div>
</section>


<style>
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
       padding: 100px 4% 60px 4%;
        border-bottom: 1px solid var(--border-gray);
        overflow: hidden;
        background: black;
       will-change: transform; 
     -webkit-backface-visibility: hidden;
      min-height: 100vh;  
       min-height: 100svh;
      overscroll-behavior: none;
    }


    .hero-container, .version-tag {
        position: relative;
        z-index: 2;
    }

    .version-tag {
        font-size: 0.7rem;
        letter-spacing: 5px;
        margin-bottom: 10px;
    }

    /* Style variants handled via classes */

    .index-hero h1 {
        font-family: 'Archivo Black', sans-serif;
        font-size: clamp(4rem, 15vw, 12rem);
        line-height: 0.85;
        letter-spacing: -4px;
        margin-bottom: 20px;
    }


    .sub-hero h1 {
        font-family: 'Archivo Black', sans-serif;
        font-size: clamp(3rem, 10vw, 8rem);
        line-height: 0.85;
        letter-spacing: -4px;
    }
.hero-cta {
    display: block;
    margin-left: auto; 
    width: fit-content;
}

@media (max-width: 768px) {
    .hero-cta {
        margin-top: 30px;
      margin-left: 0 !important;       
        margin-right: auto !important;   
        align-self: flex-start;
    }
}

/* Glass Shard Layer Overlay */
.glass-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1; /* Sits behind text, above background */
    pointer-events: none; /* Allows clicks to pass through to buttons */
    overflow: hidden;
}

/* Base Shard Styling */
.glass-shard {
    position: absolute;
    pointer-events: auto; /* Enables hover effects on shards */
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(250, 206, 226, 0.25);
    box-shadow: 0 8px 32px 0 rgba(228, 30, 129, 0.1);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.4s ease, 
                box-shadow 0.4s ease,
                background 0.4s ease;
    will-change: transform;
}

/* Shard Hover Interactive Effect */
.glass-shard:hover {
    transform: scale(1.08) rotate(3deg) translateY(-5px) !important;
    border-color: rgba(228, 30, 129, 0.8);
    box-shadow: 0 0 25px rgba(228, 30, 129, 0.4), inset 0 0 15px rgba(250, 206, 226, 0.3);
    background: rgba(250, 206, 226, 0.08);
}

/* Shard 1: Top Right Prism */
.shard-1 {
    top: 10%;
    right: 8%;
    width: 220px;
    height: 280px;
    clip-path: polygon(20% 0%, 100% 15%, 85% 100%, 0% 70%);
    animation: floatSlow 8s ease-in-out infinite alternate;
}

/* Shard 2: Left Sharp Fragment */
.shard-2 {
    bottom: 18%;
    left: 3%;
    width: 180px;
    height: 220px;
    clip-path: polygon(50% 0%, 100% 80%, 30% 100%, 0% 20%);
    animation: floatSlow 6s ease-in-out infinite alternate-reverse;
}

/* Shard 3: Small Floating Accent */
.shard-3 {
    top: 25%;
    left: 28%;
    width: 110px;
    height: 140px;
    clip-path: polygon(0 0, 90% 10%, 100% 100%, 10% 85%);
    animation: floatSlow 10s ease-in-out infinite alternate;
}

/* Subtle Idle Floating Animation */
@keyframes floatSlow {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-12px) rotate(2deg); }
}

/* Clean Mobile Handling */
@media (max-width: 768px) {
    .glass-shard {
        opacity: 0.5; /* Tone down opacity so mobile text remains ultra-legible */
    }
    .shard-3 {
        display: none; /* Hide middle shard on small screens */
    }
}

</style>
