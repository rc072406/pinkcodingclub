---
// src/components/InterviewGallery.astro
---
<section class="interview-gallery">
  <div class="gallery-header">
    <span class="section-tag">// THE ICON ARCHIVE: INTERVIEWS</span>
    <h2 class="gallery-title">UNLOCK IT</h2>
  </div>

  <div class="casting-board">
    <!-- Top Row: Left Aligned (01, 02, 03) -->
    <div class="board-row row-top">
      <!-- Polaroid 1 (Unlocked) -->
      <a href="/stories/naomi-carrigan" class="polaroid">
        <div class="side-margin left-margin">
          <span class="marker left-marker">01</span>
        </div>
        <div class="card-visual">
          <img src="https://cdn.nhcarrigan.com/profile.png" alt="Naomi Carrigan" class="card-img" />
        </div>
        <div class="side-margin right-margin">
          <span class="marker right-marker">NAOMI</span>
          <span class="marker sub-marker">DEEPGRAM ENG.</span>
        </div>
      </a>

      <!-- Polaroid 2 (Locked) -->
      <a href="#" class="polaroid locked">
        <div class="side-margin left-margin">
          <span class="marker left-marker">02</span>
        </div>
        <div class="card-visual placeholder-visual">
          <div class="static-overlay"></div>
        </div>
        <div class="side-margin right-margin">
          <span class="marker right-marker">REDACTED</span>
          <span class="marker sub-marker">CLASSIFIED</span>
        </div>
      </a>

      <!-- Polaroid 3 (Locked) -->
      <a href="#" class="polaroid locked">
        <div class="side-margin left-margin">
          <span class="marker left-marker">03</span>
        </div>
        <div class="card-visual placeholder-visual">
          <div class="static-overlay"></div>
        </div>
        <div class="side-margin right-margin">
          <span class="marker right-marker">REDACTED</span>
          <span class="marker sub-marker">PENDING</span>
        </div>
      </a>
    </div>

    <!-- Bottom Row: Right Aligned (04, 05) -->
    <div class="board-row row-bottom">
      <!-- Polaroid 4 (Locked) -->
      <a href="#" class="polaroid locked">
        <div class="side-margin left-margin">
          <span class="marker left-marker">04</span>
        </div>
        <div class="card-visual placeholder-visual">
          <div class="static-overlay"></div>
        </div>
        <div class="side-margin right-margin">
          <span class="marker right-marker">REDACTED</span>
          <span class="marker sub-marker">CLASSIFIED</span>
        </div>
      </a>

      <!-- Polaroid 5 (Locked) -->
      <a href="#" class="polaroid locked">
        <div class="side-margin left-margin">
          <span class="marker left-marker">05</span>
        </div>
        <div class="card-visual placeholder-visual">
          <div class="static-overlay"></div>
        </div>
        <div class="side-margin right-margin">
          <span class="marker right-marker">REDACTED</span>
          <span class="marker sub-marker">PENDING</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .interview-gallery {
    padding: 80px 4%;
    background: var(--bg-black, #0a0a0a);
    border-bottom: 1px solid var(--border-gray, #333);
    overflow: hidden;
  }

  .gallery-header {
    margin-bottom: 60px;
    text-align: right;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-tag {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--pink-hot, #ff0055);
    letter-spacing: 2px;
  }

  .gallery-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--pink-soft, #ffb3c6);
    margin-top: 10px;
  }

  /* Casting Board Grid Layout */
  .casting-board {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .board-row {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    width: 100%;
  }

  /* Alignment offsets for Desktop */
  .row-top {
    justify-content: flex-start;
  }

  .row-bottom {
    justify-content: flex-end;
  }

  /* Clean Polaroid Card Styling */
  .polaroid {
    display: grid;
    grid-template-columns: 55px 180px 55px;
    text-decoration: none;
    background: #fcfbf9;
    padding: 12px 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5), inset 0 0 1px rgba(0, 0, 0, 0.1);
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
    /* Straight alignment */
    transform: rotate(0deg);
  }

  .polaroid:hover {
    z-index: 10;
    transform: translateY(-6px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.7), 0 0 12px rgba(255, 0, 85, 0.25);
  }

  .card-visual {
    width: 100%;
    aspect-ratio: 3 / 4; 
    overflow: hidden;
    background: var(--bg-black, #111);
    border: 1px solid rgba(0, 0, 0, 0.15);
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.8);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) saturate(0.9);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .polaroid:hover .card-img {
    filter: contrast(1.2) saturate(1.1);
    transform: scale(1.02);
  }

  /* Locked / Placeholder visuals */
  .placeholder-visual {
    background: #111;
    position: relative;
  }

  .static-overlay {
    position: absolute;
    inset: 0;
    background-image: repeating-radial-gradient(
      circle at 0 0, 
      transparent 0, 
      var(--bg-black, #0a0a0a) 10px,
      transparent 11px
    ),
    repeating-linear-gradient(
      45deg,
      #1a1a1a,
      #1a1a1a 5px,
      #111 5px,
      #111 10px
    );
    opacity: 0.7;
  }

  /* Side Margins for Vertical Text */
  .side-margin {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .marker {
    font-family: 'Reenie Beanie', cursive, sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: 1px;
  }

  .left-marker {
    font-size: 2.2rem;
    color: #222;
    opacity: 0.85;
  }

  .right-marker {
    font-size: 2.2rem;
    color: var(--pink-hot, #ff0055);
    opacity: 0.95;
  }

  .sub-marker {
    font-size: 1.4rem;
    color: #555;
    opacity: 0.8;
  }

  .locked .right-marker,
  .locked .sub-marker {
    color: #555; 
  }

  /* Mobile Fallback: Center-align cards cleanly without offsets */
  @media (max-width: 820px) {
    .board-row {
      justify-content: center;
    }

    .casting-board {
      gap: 30px;
    }
  }
</style>
